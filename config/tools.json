    "eSim_basic": {
      "name": "eSim Core Workflow",
      "description": "Standard environment required for eSim schematic capture and circuit simulation.",
      "required": ["python", "git"],
      "recommended": ["kicad", "ngspice"]
    },
    "digital_design": {
      "name": "Digital Design & RTL",
      "description": "HDL synthesis, simulation, and verification toolchain.",
      "required": ["yosys"],
      "recommended": ["iverilog", "verilator", "ghdl"]
    },
    "pcb_design": {
      "name": "PCB Design & Fabrication",
      "description": "Schematic entry, footprint layout, and Gerber generation.",
      "required": ["kicad"],
      "recommended": ["python", "git"]
    },
    "open_source_vlsi": {
      "name": "Open-Source ASIC / VLSI Flow",
      "description": "OpenROAD, Magic, and Netgen silicon layout and LVS verification.",
      "required": [],
      "recommended": ["yosys", "openroad", "magic", "netgen"]
    }
  },
